    <string name="sv_section_flags">Incoming red flags</string>
    <string name="sv_flags_note">Same format as the draft guard. Add options after \" | \": info, caution, high, silent, tag=x, category=professional, window=N, stages=new,verification_pending. Flags show a badge on received messages; silent, tag and category act on receipt only when you add them. Nothing is ever deleted or answered.</string>
