    <string name="sv_block_warning_title">Android blocking drops messages</string>
    <string name="sv_block_warning">Android\'s system block list stops messages before this app receives them, so nothing is kept. Quarantine instead keeps every message, stored, marked read and muted, and you can undo it from the card.</string>
    <string name="sv_block_quarantine">Quarantine instead</string>
    <string name="sv_block_os_anyway">Block in Android</string>
    <string name="sv_block_manager_warning">Numbers on Android\'s block list are dropped by the system and never stored. To keep and silence a sender instead, use Quarantine on the conversation\'s card.</string>
