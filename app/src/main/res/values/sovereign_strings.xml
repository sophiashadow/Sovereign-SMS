    <string name="sv_block_warning_title">Android blocking drops messages</string>
    <string name="sv_block_warning">Android\'s system block list stops messages before this app receives them, so nothing is kept. Quarantine instead keeps every message, stored, marked read and muted, and you can undo it from the card.</string>
