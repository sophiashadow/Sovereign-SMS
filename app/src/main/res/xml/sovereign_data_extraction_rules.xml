<?xml version="1.0" encoding="utf-8"?>
<!-- Sovereign SMS (Android 12+):
     - cloud-backup: nothing app-owned goes to Google cloud backup.
     - device-transfer: the encrypted vault, its wrapped key and the Keystore-sealed
       settings are excluded. Hardware Keystore keys never migrate, so copies would be
       unreadable on the new phone; move them with a .sovbak backup instead.
     SMS/MMS live in the system Telephony provider and are not part of this app's data. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="sovereign_vault.db" />
        <exclude domain="database" path="sovereign_vault.db-wal" />
        <exclude domain="database" path="sovereign_vault.db-shm" />
        <exclude domain="database" path="sovereign_vault.db-journal" />
        <exclude domain="sharedpref" path="sovereign_vault_key.xml" />
        <exclude domain="sharedpref" path="sovereign_sealed.xml" />
    </device-transfer>
</data-extraction-rules>
