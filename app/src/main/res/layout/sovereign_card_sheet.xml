<?xml version="1.0" encoding="utf-8"?>
<!-- Sovereign SMS: client card. Stored only in the encrypted vault, never in Contacts. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/sv_card_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/activity_margin">

        <org.fossify.commons.views.MyTextView
            android:id="@+id/sv_card_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sv_card"
            android:textSize="@dimen/big_text_size"
            android:textStyle="bold" />

        <org.fossify.commons.views.MyTextView
            android:id="@+id/sv_card_derived"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0.7"
            android:paddingBottom="@dimen/small_margin" />

        <org.fossify.commons.views.MyEditText
            android:id="@+id/sv_card_alias"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/sv_card_alias_hint"
            android:importantForAutofill="no"
            android:inputType="textPersonName|textNoSuggestions"
            android:maxLines="1" />

        <org.fossify.commons.views.MyTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/medium_margin"
            android:text="@string/sv_card_stage"
            android:textStyle="bold" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/sv_card_stage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleSelection="true"
            xmlns:app="http://schemas.android.com/apk/res-auto" />

        <org.fossify.commons.views.MyTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/medium_margin"
            android:text="@string/sv_card_checklist"
            android:textStyle="bold" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/sv_card_checklist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <org.fossify.commons.views.MyEditText
            android:id="@+id/sv_card_tier"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/sv_card_tier_hint"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1" />

        <org.fossify.commons.views.MyEditText
            android:id="@+id/sv_card_window"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/sv_card_window_hint"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1" />

        <org.fossify.commons.views.MyMaterialSwitch
            android:id="@+id/sv_card_optin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="@dimen/small_margin"
            android:text="@string/sv_card_optin" />

        <org.fossify.commons.views.MyMaterialSwitch
            android:id="@+id/sv_card_quarantine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="@dimen/small_margin"
            android:text="@string/sv_card_quarantine" />

        <org.fossify.commons.views.MyEditText
            android:id="@+id/sv_card_notes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top|start"
            android:hint="@string/sv_card_notes_hint"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="3" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="horizontal"
            android:paddingTop="@dimen/medium_margin">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sv_card_log_session"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sv_card_log_session"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sv_card_preserve"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sv_preserve_thread" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sv_card_save"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sv_card_save" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
